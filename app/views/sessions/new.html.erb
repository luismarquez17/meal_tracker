<div class="min-h-[80vh] flex flex-col justify-center py-6 px-4 sm:px-6 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-md text-center">
    <div class="inline-flex w-16 h-16 rounded-3xl bg-gradient-to-tr from-emerald-600 to-teal-400 items-center justify-center text-white shadow-xl shadow-emerald-500/20 mb-4 animate-bounce-subtle">
      <span class="text-3xl">🍲</span>
    </div>
    <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Bienvenido a Meal<span class="text-emerald-600">Tracker</span></h2>
    <p class="text-xs text-slate-500 mt-1">Control de tus comidas, ahorro inteligente y suscripciones.</p>
  </div>

  <div class="mt-6 sm:mx-auto sm:w-full sm:max-w-md">
    <div class="bg-white py-7 px-5 sm:px-8 rounded-3xl border border-slate-200/80 shadow-xl shadow-slate-200/50 space-y-6">

      <!-- Botón Real de Google OAuth -->
      <div>
        <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false }, class: "w-full flex items-center justify-center space-x-3 py-3 px-4 rounded-2xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm shadow-xs transition active:scale-[0.98] cursor-pointer" do %>
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
          </svg>
          <span>Continuar con Google</span>
        <% end %>

        <% unless ENV["GOOGLE_CLIENT_ID"].present? && ENV["GOOGLE_CLIENT_ID"] != "dummy_id" %>
          <p class="mt-2 text-[11px] text-amber-600 text-center leading-snug">
            ⚠️ Falta configurar <code class="bg-amber-50 px-1 rounded font-mono text-[10px]">GOOGLE_CLIENT_ID</code> en tu archivo <code class="bg-amber-50 px-1 rounded font-mono text-[10px]">.env</code> para activar Google.
          </p>
        <% end %>
      </div>

      <div class="relative flex items-center justify-center">
        <div class="border-t border-slate-200 w-full"></div>
        <span class="bg-white px-3 text-xs font-bold text-slate-400 uppercase tracking-wider relative">o con contraseña</span>
      </div>

      <!-- Formulario de Correo y Contraseña -->
      <%= form_with url: login_path, method: :post, local: true, id: "login-form", class: "space-y-4" do |f| %>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Correo Electrónico</label>
          <%= f.email_field :email, id: "email-field", required: true, autocomplete: "email", placeholder: "ejemplo@correo.com", class: "w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition font-medium" %>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Contraseña</label>
          <%= f.password_field :password, id: "password-field", required: true, autocomplete: "current-password", placeholder: "••••••", class: "w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition font-medium" %>
        </div>

        <button type="submit" class="w-full py-3 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-500/20 active:scale-[0.98] transition cursor-pointer">
          Iniciar Sesión
        </button>
      <% end %>



      <div class="text-center pt-2 border-t border-slate-100">
        <p class="text-xs text-slate-500 font-medium">
          ¿No tienes una cuenta aún?
          <%= link_to "Regístrate gratis aquí", signup_path, class: "font-bold text-emerald-600 hover:text-emerald-700 hover:underline" %>
        </p>
      </div>

    </div>
  </div>
</div>

<script>
  function fillSuperAdmin() {
    const emailField = document.getElementById('email-field');
    const passField = document.getElementById('password-field');
    if (emailField && passField) {
      emailField.value = 'luismarquezocando2006@gmail.com';
      passField.value = '123456';
      document.getElementById('login-form').submit();
    }
  }
</script>
