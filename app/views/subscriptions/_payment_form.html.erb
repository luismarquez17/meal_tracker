<div class="bg-white rounded-3xl p-5 border border-slate-200/80 shadow-xs">
  <div class="flex items-center space-x-3 mb-4">
    <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-lg font-bold">
      📝
    </div>
    <div>
      <h3 class="text-sm font-extrabold text-slate-900">Reportar Pago Realizado</h3>
      <p class="text-xs text-slate-400">Ingresa los datos para que el Super Admin valide tu pago.</p>
    </div>
  </div>

  <%= form_with model: payment, url: create_payment_subscription_path, method: :post, local: true, class: "space-y-4" do |f| %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Método de Pago Usado</label>
        <%= f.select :payment_method, [["📱 Pago Móvil (Venezuela)", "pago_movil"], ["🟡 Binance Pay / USDT", "binance"]], {}, id: "payment-method-select", onchange: "updatePaymentMethodDetails(this.value)", class: "w-full px-3.5 py-2.5 text-xs font-bold text-slate-900 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition cursor-pointer" %>
      </div>

      <div data-controller="money-mask" data-money-mask-initial-value="<%= payment_setting.monthly_price_usd %>">
        <label class="block text-xs font-bold text-slate-700 mb-1">Monto Pagado ($ USD)</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-bold text-sm">
            $
          </div>
          <%= f.hidden_field :amount, value: sprintf('%.2f', payment_setting.monthly_price_usd), data: { "money-mask-target": "hidden" } %>
          <input type="text"
                 inputmode="numeric"
                 autocomplete="off"
                 placeholder="0,00"
                 data-money-mask-target="display"
                 class="w-full pl-8 pr-8 py-2.5 text-xs font-bold text-slate-900 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition">
          <button type="button"
                  tabindex="-1"
                  data-action="click->money-mask#clear"
                  class="absolute inset-y-0 right-0 pr-2.5 flex items-center text-slate-300 hover:text-slate-500 text-xs font-bold transition cursor-pointer"
                  title="Borrar monto">
            ✕
          </button>
        </div>
      </div>
    </div>

    <!-- Banner Informativo de Pago Móvil con Tasa y Monto en Bs -->
    <div id="pago-movil-info-banner" class="p-3.5 bg-blue-50/90 border border-blue-200 rounded-2xl flex items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center text-lg font-bold shrink-0 shadow-sm shadow-blue-500/20">
          🇻🇪
        </div>
        <div>
          <div class="flex items-baseline space-x-2 flex-wrap">
            <span class="text-xs font-extrabold text-blue-900">Monto a pagar en Bolívares:</span>
            <span class="text-base font-black text-blue-950 font-mono"><%= sprintf('%.2f', payment_setting.amount_in_bs) %> Bs.</span>
          </div>
          <p class="text-[11px] text-blue-700 font-semibold mt-0.5">
            Tasa oficial BCV de hoy: <strong class="font-extrabold text-blue-950">1 USD = <%= sprintf('%.2f', payment_setting.usd_to_bs_rate) %> Bs.</strong> (Tarifa: $<%= sprintf('%.2f', payment_setting.monthly_price_usd) %> USD)
          </p>
        </div>
      </div>
      <button type="button" onclick="navigator.clipboard.writeText('<%= sprintf('%.2f', payment_setting.amount_in_bs) %>'); alert('¡Monto de <%= sprintf('%.2f', payment_setting.amount_in_bs) %> Bs copiado!');" class="px-3 py-1.5 bg-white hover:bg-blue-100 text-blue-700 border border-blue-200 rounded-xl text-xs font-bold transition shadow-2xs whitespace-nowrap cursor-pointer active:scale-95 shrink-0">
        📋 Copiar Bs
      </button>
    </div>

    <!-- Banner Informativo de Binance -->
    <div id="binance-info-banner" class="p-3.5 bg-amber-50/90 border border-amber-200 rounded-2xl hidden items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center text-lg font-bold shrink-0 shadow-sm shadow-amber-500/20">
          🟡
        </div>
        <div>
          <div class="flex items-baseline space-x-2">
            <span class="text-xs font-extrabold text-amber-900">Monto a pagar en Binance:</span>
            <span class="text-base font-black text-amber-950 font-mono">$<%= sprintf('%.2f', payment_setting.monthly_price_usd) %> USDT</span>
          </div>
          <p class="text-[11px] text-amber-700 font-semibold mt-0.5">
            Pago vía Binance Pay (ID: <strong class="font-bold"><%= payment_setting.binance_pay_id %></strong>) o red <strong class="font-bold"><%= payment_setting.binance_network %></strong>.
          </p>
        </div>
      </div>
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">
        Número de Referencia (últimos 4 a 6 dígitos) <span class="text-rose-500">*</span>
      </label>
      <%= f.text_field :reference_number, id: "reference-field", required: true, minlength: 4, title: "Debe ingresar al menos 4 dígitos", placeholder: "Ej. 481920 (últimos 4 a 6 dígitos de tu Pago Móvil)", class: "w-full px-3.5 py-2.5 text-xs font-mono font-bold text-slate-900 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition" %>
      <p id="reference-help" class="text-[11px] text-slate-400 mt-1">Coloca los últimos 4 a 6 dígitos emitidos por tu banco en el comprobante de Pago Móvil o Binance.</p>
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">
        Observaciones o Detalles (Opcional)
      </label>
      <%= f.text_area :notes, rows: 2, placeholder: "Ej. Pagado desde cuenta Banesco de Carlos Pérez a las 2:30 PM", class: "w-full px-3.5 py-2 text-xs font-medium text-slate-900 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition resize-none" %>
    </div>

    <!-- Adjuntar Comprobante o Captura -->
    <div>
      <label class="block text-xs font-bold text-slate-700 mb-1">
        Adjuntar Comprobante o Captura de Pantalla <span class="text-slate-400 font-normal">(Opcional)</span>
      </label>
      <div class="mt-1 flex justify-center px-4 pt-4 pb-4 border-2 border-slate-200 border-dashed rounded-2xl hover:border-emerald-400 transition bg-slate-50/50">
        <div class="space-y-1 text-center">
          <div class="text-2xl mb-1">📎</div>
          <div class="flex text-xs text-slate-600 justify-center">
            <label for="payment_receipt" class="relative cursor-pointer bg-white rounded-xl font-bold text-emerald-600 hover:text-emerald-500 px-3 py-1.5 border border-slate-200 shadow-2xs hover:bg-slate-50 transition">
              <span>Seleccionar foto o captura</span>
              <%= f.file_field :receipt, id: "payment_receipt", accept: "image/*,application/pdf", class: "sr-only", onchange: "handleFileSelect(this)" %>
            </label>
          </div>
          <p id="file-chosen-name" class="text-[11px] text-slate-500 font-medium">PNG, JPG, WEBP o PDF</p>
        </div>
      </div>
    </div>

    <div class="pt-2">
      <button type="submit" id="submit-payment-btn" class="w-full py-3 px-4 rounded-2xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-md shadow-emerald-500/20 active:scale-[0.98] transition flex items-center justify-center space-x-2 cursor-pointer">
        <span>🚀</span>
        <span id="submit-payment-btn-text">Enviar Reporte de Pago (<%= sprintf('%.2f', payment_setting.amount_in_bs) %> Bs / $<%= sprintf('%.2f', payment_setting.monthly_price_usd) %> USD)</span>
      </button>
    </div>
  <% end %>
</div>

<script>
  function updatePaymentMethodDetails(method) {
    const refInput = document.getElementById('reference-field');
    const refHelp = document.getElementById('reference-help');
    const pagoMovilBanner = document.getElementById('pago-movil-info-banner');
    const binanceBanner = document.getElementById('binance-info-banner');
    const submitBtnText = document.getElementById('submit-payment-btn-text');

    if (method === 'pago_movil') {
      if (refInput) refInput.placeholder = 'Ej. 481920 (últimos 4 a 6 dígitos de tu Pago Móvil)';
      if (refHelp) refHelp.innerText = 'Coloca los últimos 4 a 6 dígitos emitidos por tu banco en el comprobante de Pago Móvil.';
      if (pagoMovilBanner) {
        pagoMovilBanner.classList.remove('hidden');
        pagoMovilBanner.classList.add('flex');
      }
      if (binanceBanner) {
        binanceBanner.classList.add('hidden');
        binanceBanner.classList.remove('flex');
      }
      if (submitBtnText) submitBtnText.innerText = 'Enviar Reporte de Pago (<%= sprintf('%.2f', payment_setting.amount_in_bs) %> Bs / $<%= sprintf('%.2f', payment_setting.monthly_price_usd) %> USD)';
    } else {
      if (refInput) refInput.placeholder = 'Ej. 481920 (últimos 4 a 6 dígitos o ID de Binance)';
      if (refHelp) refHelp.innerText = 'Coloca los últimos 4 a 6 dígitos o el Order ID de Binance Pay / TXID.';
      if (pagoMovilBanner) {
        pagoMovilBanner.classList.add('hidden');
        pagoMovilBanner.classList.remove('flex');
      }
      if (binanceBanner) {
        binanceBanner.classList.remove('hidden');
        binanceBanner.classList.add('flex');
      }
      if (submitBtnText) submitBtnText.innerText = 'Enviar Reporte de Pago ($<%= sprintf('%.2f', payment_setting.monthly_price_usd) %> USDT)';
    }
  }

  function handleFileSelect(input) {
    const chosenName = document.getElementById('file-chosen-name');
    if (input.files && input.files[0]) {
      chosenName.innerText = '✅ Comprobante adjunto: ' + input.files[0].name;
      chosenName.className = 'text-[11px] text-emerald-700 font-bold';
    }
  }

  // Ejecutar al cargar la página
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      const select = document.getElementById('payment-method-select');
      if (select) updatePaymentMethodDetails(select.value);
    });
  } else {
    const select = document.getElementById('payment-method-select');
    if (select) updatePaymentMethodDetails(select.value);
  }
</script>
