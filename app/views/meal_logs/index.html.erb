<%
  currency = current_setting.currency_symbol
%>

<div class="space-y-4">
  <!-- Cabecera y Filtros -->
  <div class="bg-white rounded-3xl p-4 border border-slate-100 shadow-2xs space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-extrabold text-slate-900 flex items-center space-x-2">
        <span>📜</span>
        <span>Historial de Comidas</span>
      </h2>
      <span class="text-xs font-semibold text-slate-400">
        <%= @meal_logs.size %> <%= @meal_logs.size == 1 ? "registro" : "registros" %>
      </span>
    </div>

    <!-- Filtro de Ubicación (Pills táctiles) -->
    <div class="flex items-center space-x-2 overflow-x-auto pb-1">
      <%= link_to "Todas", meal_logs_path(period: @filter_period, meal_type: @filter_type),
                  class: "px-3 py-1.5 rounded-full text-xs font-bold transition whitespace-nowrap #{params[:location].blank? ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}" %>

      <%= link_to "🏠 En Casa", meal_logs_path(location: "home", period: @filter_period, meal_type: @filter_type),
                  class: "px-3 py-1.5 rounded-full text-xs font-bold transition whitespace-nowrap #{params[:location] == 'home' ? 'bg-emerald-600 text-white' : 'bg-emerald-50 text-emerald-800 hover:bg-emerald-100'}" %>

      <%= link_to "🍔 En la Calle", meal_logs_path(location: "street", period: @filter_period, meal_type: @filter_type),
                  class: "px-3 py-1.5 rounded-full text-xs font-bold transition whitespace-nowrap #{params[:location] == 'street' ? 'bg-amber-600 text-white' : 'bg-amber-50 text-amber-800 hover:bg-amber-100'}" %>
    </div>
  </div>

  <!-- Lista de Comidas -->
  <div class="space-y-2.5">
    <% if @meal_logs.any? %>
      <% @meal_logs.each do |log| %>
        <div class="bg-white rounded-3xl p-4 border border-slate-100 shadow-2xs flex items-center justify-between transition hover:shadow-xs">
          <div class="flex items-center space-x-3">
            <div class="w-11 h-11 rounded-2xl <%= log.home? ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-amber-50 text-amber-600 border border-amber-100' %> flex items-center justify-center text-xl shadow-2xs">
              <%= log.meal_icon %>
            </div>

            <div>
              <div class="flex items-center space-x-2">
                <span class="font-bold text-slate-900 text-sm"><%= log.human_meal_type %></span>
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full <%= log.home? ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                  <%= log.human_location %>
                </span>
              </div>

              <div class="text-xs text-slate-400 mt-0.5">
                <%= log.date.strftime("%d/%m/%Y") %>
                <% if log.place_name.present? %>
                  · <span class="font-medium text-slate-600">📍 <%= log.place_name %></span>
                <% end %>
              </div>

              <% if log.note.present? %>
                <div class="text-[11px] text-slate-500 italic mt-0.5">
                  "<%= log.note %>"
                </div>
              <% end %>
            </div>
          </div>

          <div class="flex items-center space-x-3 text-right">
            <div>
              <% if log.home? %>
                <span class="inline-flex items-center text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-100">
                  🏠 Casera
                </span>
              <% else %>
                <div class="font-black text-rose-600 text-sm">
                  <%= currency %><%= number_with_precision(log.amount, precision: 2) %>
                </div>
                <div class="text-[10px] text-slate-400">gastado</div>
              <% end %>
            </div>

            <% if log.user_id == current_user.id || current_user.admin? || (current_user.household_leader? && current_user.household_id == log.user&.household_id) %>
              <%= button_to meal_log_path(log), method: :delete, data: { turbo_confirm: "¿Deseas borrar este registro?" }, class: "p-2 rounded-xl text-slate-300 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white rounded-3xl p-8 text-center border border-slate-100 shadow-2xs">
        <div class="text-4xl mb-2">🍽️</div>
        <h3 class="font-bold text-slate-800 text-base">No hay comidas registradas</h3>
        <p class="text-xs text-slate-400 mt-1 max-w-xs mx-auto">
          Comienza registrando tus comidas en el panel diario para llevar el control de tus gastos.
        </p>
        <div class="mt-4">
          <%= link_to "Ir al Registro Diario", root_path, class: "inline-flex items-center px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl shadow-xs transition" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
