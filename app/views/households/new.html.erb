<div class="space-y-6 max-w-md mx-auto">
  <!-- Encabezado de Bienvenida a Modo Pareja / Hogar -->
  <div class="text-center space-y-2 pt-2">
    <div class="w-16 h-16 mx-auto rounded-3xl bg-gradient-to-tr from-emerald-600 to-teal-400 flex items-center justify-center text-white text-3xl shadow-lg shadow-emerald-500/20">
      🏠
    </div>
    <h1 class="text-xl md:text-2xl font-black text-slate-900 tracking-tight">Modo Pareja & Hogar</h1>
    <p class="text-xs text-slate-600 font-medium max-w-sm mx-auto">
      Lleva el control de las comidas y el mercado junto a tu pareja o familia. ¡Alcancen metas comunes!
    </p>
  </div>

  <!-- Opción 1: Crear un Nuevo Hogar -->
  <div class="bg-white rounded-3xl p-5 md:p-6 shadow-xs border border-slate-100 space-y-4">
    <div class="flex items-center space-x-2.5">
      <span class="w-8 h-8 rounded-xl bg-emerald-100 text-emerald-800 font-bold flex items-center justify-center text-sm">
        1
      </span>
      <div>
        <h2 class="text-sm font-extrabold text-slate-900">Crear un Nuevo Hogar</h2>
        <p class="text-[11px] text-slate-500">Tú serás el anfitrión y podrás invitar a tu pareja o familiares.</p>
      </div>
    </div>

    <%= form_with(model: @household, url: household_path, class: "space-y-3.5") do |f| %>
      <div>
        <%= f.label :name, "Nombre del Hogar o Familia", class: "block text-xs font-bold text-slate-700 mb-1" %>
        <%= f.text_field :name,
                         placeholder: "Ej. Familia Márquez, Casa Luis y Ana...",
                         required: true,
                         class: "block w-full px-3.5 py-2.5 text-xs font-semibold text-slate-900 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition" %>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">
          Tu apodo o rol en la casa <span class="text-slate-400 font-normal">(opcional)</span>
        </label>
        <input type="text"
               name="user_alias"
               value="<%= current_user.name %>"
               placeholder="Ej. Papá, Mamá, Luis, Chef..."
               class="block w-full px-3.5 py-2.5 text-xs font-semibold text-slate-900 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition">
      </div>

      <button type="submit"
              class="w-full py-3 px-4 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-700 hover:to-teal-600 text-white font-extrabold text-xs shadow-md shadow-emerald-500/20 active:scale-95 transition flex items-center justify-center space-x-1.5 cursor-pointer">
        <span>✨ Crear mi Hogar y Generar Código</span>
      </button>
    <% end %>
  </div>

  <!-- Opción 2: Unirse a un Hogar Existente con Código -->
  <div class="bg-white rounded-3xl p-5 md:p-6 shadow-xs border border-slate-100 space-y-4">
    <div class="flex items-center space-x-2.5">
      <span class="w-8 h-8 rounded-xl bg-blue-100 text-blue-800 font-bold flex items-center justify-center text-sm">
        2
      </span>
      <div>
        <h2 class="text-sm font-extrabold text-slate-900">¿Tu pareja ya creó el hogar?</h2>
        <p class="text-[11px] text-slate-500">Introduce el código de 6 caracteres que te compartieron.</p>
      </div>
    </div>

    <%= form_with(url: join_household_path, method: :post, class: "space-y-3.5") do %>
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">
          Código de Invitación
        </label>
        <input type="text"
               name="invite_code"
               placeholder="Ej. CASA-8X4A"
               required
               class="block w-full px-3.5 py-2.5 text-center tracking-widest font-mono text-sm font-black text-slate-900 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition uppercase">
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">
          Tu apodo en la casa <span class="text-slate-400 font-normal">(opcional)</span>
        </label>
        <input type="text"
               name="user_alias"
               value="<%= current_user.name %>"
               placeholder="Ej. Amor, Esposo, Pareja, Luis..."
               class="block w-full px-3.5 py-2.5 text-xs font-semibold text-slate-900 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition">
      </div>

      <button type="submit"
              class="w-full py-3 px-4 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white font-extrabold text-xs shadow-md shadow-blue-500/20 active:scale-95 transition flex items-center justify-center space-x-1.5 cursor-pointer">
        <span>🔗 Unirme al Hogar</span>
      </button>
    <% end %>
  </div>
</div>
