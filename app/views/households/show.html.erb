<%
  total_saved = @household.total_saved_month
  total_saved_bs = (total_saved * @bcv_rate).round(2)
%>

<div class="space-y-4 max-w-md md:max-w-xl mx-auto">
  <!-- Tarjeta Principal del Hogar -->
  <div class="bg-gradient-to-tr from-slate-900 to-slate-800 rounded-3xl p-5 md:p-6 text-white shadow-xl space-y-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md flex items-center justify-center text-2xl shadow-xs">
          🏠
        </div>
        <div>
          <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400">Hogar Familiar</span>
          <h1 class="text-lg md:text-xl font-black text-white leading-tight"><%= @household.name %></h1>
        </div>
      </div>
      <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-white/15 text-slate-200">
        <%= @members.count %> <%= @members.count == 1 ? 'miembro' : 'miembros' %>
      </span>
    </div>

    <!-- Caja de Invitación (Código + WhatsApp) -->
    <div class="p-3.5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 space-y-2.5">
      <div class="flex items-center justify-between text-xs font-semibold text-slate-300">
        <span>Código para invitar a tu pareja o familia:</span>
        <span class="text-[11px] text-emerald-400 font-bold">1 suscripción cubre a todos</span>
      </div>

      <div class="flex items-center space-x-2">
        <div class="flex-1 py-2 px-3 bg-black/30 rounded-xl font-mono text-center font-black tracking-widest text-sm text-emerald-300 border border-emerald-500/30">
          <%= @household.invite_code %>
        </div>

        <button type="button"
                onclick="navigator.clipboard.writeText('<%= @household.invite_code %>'); alert('¡Código copiado al portapapeles!');"
                class="py-2 px-3 rounded-xl bg-white/20 hover:bg-white/30 text-white text-xs font-bold transition active:scale-95 cursor-pointer"
                title="Copiar código">
          📋 Copiar
        </button>

        <%
          invite_wa = "¡Hola! Únete a nuestro hogar '#{@household.name}' en MealTracker para llevar juntos los gastos de comida y mercado 🍲.\n\n" \
                      "Código de invitación: *#{@household.invite_code}*\n" \
                      "Entra aquí: #{request.base_url}/household/new"
          invite_wa_url = "https://wa.me/?text=#{CGI.escape(invite_wa)}"
        %>
        <a href="<%= invite_wa_url %>"
           target="_blank"
           rel="noopener noreferrer"
           class="py-2 px-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 text-xs font-black transition active:scale-95 flex items-center space-x-1"
           title="Invitar por WhatsApp">
          <span>💬</span>
          <span>Invitar</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Ahorro Total del Hogar este Mes -->
  <div class="bg-gradient-to-r from-emerald-50 to-teal-50 rounded-3xl p-5 border border-emerald-200/80 shadow-2xs space-y-1.5">
    <div class="flex items-center space-x-2.5">
      <div class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl shadow-xs">
        💰
      </div>
      <div>
        <h2 class="text-xs font-bold uppercase tracking-wider text-emerald-800">Ahorro del Hogar este Mes</h2>
        <div class="flex items-baseline space-x-2">
          <span class="text-2xl font-black text-emerald-950">$<%= sprintf('%.2f', total_saved) %> USD</span>
          <span class="text-xs font-bold text-emerald-700">(~<%= sprintf('%.2f', total_saved_bs) %> Bs.)</span>
        </div>
      </div>
    </div>
    <p class="text-xs text-emerald-800/80 font-medium pt-1">
      🎉 Dinero ahorrado gracias a las comidas preparadas en casa por todos los miembros del hogar.
    </p>
  </div>

  <!-- Widget "¿Quién cocina hoy?" -->
  <%= render "dashboard/cooking_turn_widget", household: @household, date: Date.current %>

  <!-- Ranking Semanal Familiar ("Chef de la Casa") -->
  <div class="bg-white rounded-3xl p-5 shadow-xs border border-slate-100 space-y-3">
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <span class="text-xl">🏆</span>
        <div>
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Ranking Semanal del Hogar</h2>
          <p class="text-xs text-slate-600">Quién ha cocinado más en casa esta semana</p>
        </div>
      </div>
      <%= link_to weekly_summary_path(scope: "family"), class: "text-xs font-bold text-emerald-600 hover:text-emerald-700 underline" do %>
        Ver Wrapped Hogar ✨
      <% end %>
    </div>

    <div class="space-y-2">
      <% @leaderboard.each_with_index do |entry, idx| %>
        <div class="p-3 rounded-2xl flex items-center justify-between <%= idx == 0 ? 'bg-amber-50 border border-amber-200/80' : 'bg-slate-50 border border-slate-100' %>">
          <div class="flex items-center space-x-3">
            <span class="text-sm font-black <%= idx == 0 ? 'text-amber-600' : 'text-slate-400' %>">
              <%= idx == 0 ? '👑 1º' : "#{idx + 1}º" %>
            </span>
            <div>
              <span class="text-xs font-bold text-slate-900 block"><%= entry[:user].display_name %></span>
              <span class="text-[11px] text-slate-500">
                Aportó $<%= sprintf('%.2f', entry[:saved]) %> en ahorro
              </span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-xs font-extrabold text-emerald-700 block">
              <%= entry[:home_count] %> en casa 🏠
            </span>
            <span class="text-[10px] text-slate-400">
              $<%= sprintf('%.2f', entry[:street_spent]) %> fuera
            </span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Miembros del Hogar -->
  <div class="bg-white rounded-3xl p-5 shadow-xs border border-slate-100 space-y-3">
    <div class="flex items-center justify-between">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Miembros Activos</h2>
      <span class="text-xs text-slate-500 font-medium">Sincronizados en tiempo real</span>
    </div>

    <div class="divide-y divide-slate-100">
      <% @members.each do |member| %>
        <div class="py-2.5 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center font-bold text-slate-700 text-sm">
              <%= member.display_name.first.upcase %>
            </div>
            <div>
              <div class="flex items-center space-x-1.5">
                <span class="text-xs font-bold text-slate-900"><%= member.display_name %></span>
                <% if member.id == current_user.id %>
                  <span class="px-1.5 py-0.2 bg-emerald-100 text-emerald-800 text-[10px] font-black rounded-md">Tú</span>
                <% end %>
                <% if member.id == @household.created_by_id %>
                  <span class="px-1.5 py-0.2 bg-amber-100 text-amber-800 text-[10px] font-bold rounded-md">Anfitrión</span>
                <% end %>
              </div>
              <span class="text-[11px] text-slate-500"><%= member.email %></span>
            </div>
          </div>

          <span class="text-xs font-semibold text-slate-600">
            <%= member.active_subscription? ? '⭐ Plan Activo' : 'Sin plan' %>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Ajustes del Hogar -->
  <div class="bg-white rounded-3xl p-5 shadow-xs border border-slate-100 space-y-4">
    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Ajustes del Hogar</h2>

    <%= form_with(model: @household, url: update_goal_household_path, method: :patch, class: "space-y-3") do |f| %>
      <div>
        <%= f.label :name, "Nombre del Hogar o Familia", class: "block text-xs font-bold text-slate-700 mb-1" %>
        <%= f.text_field :name, class: "block w-full px-3.5 py-2.5 text-xs font-semibold text-slate-900 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition" %>
      </div>
      <button type="submit" class="py-2.5 px-4 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition cursor-pointer">
        Guardar Nombre
      </button>
    <% end %>

    <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
      <span class="text-xs text-slate-500">¿Quieres desvincularte de este hogar?</span>
      <%= button_to leave_household_path, method: :delete, data: { turbo_confirm: "¿Seguro que deseas salir de este hogar?" }, class: "text-xs font-bold text-rose-600 hover:text-rose-700 hover:underline cursor-pointer" do %>
        Abandonar Hogar
      <% end %>
    </div>
  </div>
</div>
