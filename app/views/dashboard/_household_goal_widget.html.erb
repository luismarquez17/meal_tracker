<%
  total_saved = household.total_saved_month(date)
  goal_amount = household.savings_goal_amount || 30.0
  progress = household.savings_goal_progress_percentage(date)
  goal_met = household.savings_goal_met?(date)
%>

<div class="bg-gradient-to-r from-emerald-800 to-teal-800 rounded-3xl p-4 md:p-5 text-white shadow-md space-y-2.5">
  <div class="flex items-center justify-between">
    <div class="flex items-center space-x-2">
      <span class="text-xl">🎯</span>
      <div>
        <span class="text-[10px] uppercase font-black tracking-widest text-emerald-300">Meta Familiar: <%= household.savings_goal_name %></span>
        <h4 class="text-xs md:text-sm font-extrabold text-white leading-tight">
          Llevan $<%= sprintf('%.2f', total_saved) %> de $<%= sprintf('%.2f', goal_amount) %> USD
        </h4>
      </div>
    </div>
    <span class="px-2 py-0.5 rounded-full text-[11px] font-black bg-white/20 text-white">
      <%= progress %>%
    </span>
  </div>

  <div class="w-full bg-black/20 rounded-full h-2.5 overflow-hidden p-0.5">
    <div class="h-full rounded-full bg-emerald-400 transition-all duration-500" style="width: <%= progress %>%"></div>
  </div>

  <div class="flex items-center justify-between text-[11px] text-emerald-100">
    <span>🍲 Cada comida en casa de la familia suma a la meta</span>
    <%= link_to "Ver Hogar →", household_path, class: "font-black underline hover:text-white" %>
  </div>
</div>
