<%
  prev_day = @date - 1.day
  next_day = @date + 1.day
  is_today = @date == Date.current
  fecha_formateada = spanish_full_date(@date)
%>

<div class="space-y-4">
  <!-- Selector de Día (Mobile-first, navegación rápida con 1 toque) -->
  <div class="bg-white rounded-3xl p-3.5 shadow-2xs border border-slate-100 flex items-center justify-between">
    <%= link_to dashboard_path(date: prev_day), class: "w-10 h-10 rounded-2xl bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-700 font-bold transition active:scale-95 shadow-2xs", title: "Día anterior" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
      </svg>
    <% end %>

    <div class="text-center flex-1 px-2">
      <div class="flex items-center justify-center space-x-1.5">
        <span class="text-sm md:text-base font-extrabold text-slate-900"><%= fecha_formateada %></span>
        <% if is_today %>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800">
            Hoy
          </span>
        <% else %>
          <%= link_to "Ir a Hoy", dashboard_path(date: Date.current), class: "text-[11px] font-semibold text-emerald-600 hover:text-emerald-700 underline" %>
        <% end %>
      </div>

      <!-- Selector de fecha nativo accesible -->
      <form action="<%= dashboard_path %>" method="get" class="inline-block mt-0.5">
        <input type="date"
               name="date"
               value="<%= @date %>"
               onchange="this.form.submit()"
               class="text-xs text-slate-600 bg-transparent border-none p-0 cursor-pointer font-medium hover:text-slate-900 focus:ring-0">
      </form>
    </div>

    <%= link_to dashboard_path(date: next_day), class: "w-10 h-10 rounded-2xl bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-700 font-bold transition active:scale-95 shadow-2xs", title: "Día siguiente" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    <% end %>
  </div>

  <!-- Resumen del día (Gasto vs Ahorro hoy) -->
  <%= render "dashboard/daily_kpis" %>

  <!-- Comidas del Día (Desayuno, Almuerzo, Cena) -->
  <div class="space-y-3">
    <div class="flex items-center justify-between px-1">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-600">Registro Diario</h2>
      <span class="text-xs font-semibold text-slate-600">
        <%= @meals.size %>/3 registradas
      </span>
    </div>

    <!-- 1. Desayuno -->
    <%= render "dashboard/meal_slot", meal: @breakfast, meal_type: "breakfast", date: @date %>

    <!-- 2. Almuerzo -->
    <%= render "dashboard/meal_slot", meal: @lunch, meal_type: "lunch", date: @date %>

    <!-- 3. Cena -->
    <%= render "dashboard/meal_slot", meal: @dinner, meal_type: "dinner", date: @date %>
  </div>

  <!-- Gastos Hormiga & Extras de Hoy (Café, Pasajes, Recargas, etc.) -->
  <%= render "dashboard/micro_expenses" %>

  <!-- Balance del Mes Actual (Tarjeta destacada al pie) -->
  <%= render "dashboard/monthly_kpis" %>
</div>
