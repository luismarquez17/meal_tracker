<%
  labels = { "breakfast" => "Desayuno", "lunch" => "Almuerzo", "dinner" => "Cena", "snack" => "Snack / Merienda" }
  icons  = { "breakfast" => "🍳", "lunch" => "🥗", "dinner" => "🍲", "snack" => "☕" }
  title  = labels[meal_type] || meal_type.titleize
  icon   = icons[meal_type] || "🍽️"
  currency = current_setting.currency_symbol
%>

<div id="meal_slot_<%= meal_type %>" class="bg-white rounded-3xl p-4 md:p-5 shadow-xs border border-slate-100/80 transition-all hover:shadow-md" data-controller="meal-slot">
  <% if meal.present? && meal.persisted? %>
    <!-- Estado: Ya registrado -->
    <div class="flex items-start justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-12 h-12 rounded-2xl <%= meal.home? ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-amber-50 text-amber-600 border border-amber-100' %> flex items-center justify-center text-2xl shadow-xs">
          <%= icon %>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h3 class="font-bold text-slate-900 text-base"><%= title %></h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold <%= meal.home? ? 'bg-emerald-100/80 text-emerald-800' : 'bg-amber-100/80 text-amber-800' %>">
              <%= meal.home? ? "🏠 En Casa" : "🍔 En la Calle" %>
            </span>
          </div>

          <div class="mt-1 flex flex-wrap items-center gap-x-2 text-sm">
            <% if meal.home? %>
              <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md">
                Comida hecha en casa
              </span>
            <% else %>
              <span class="font-bold text-rose-600">
                Gastaste <%= meal.formatted_dual_amount %>
              </span>
              <% if meal.place_name.present? %>
                <span class="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-md font-medium">
                  📍 <%= meal.place_name %>
                </span>
              <% end %>
            <% end %>
          </div>

          <% if meal.user.present? && current_user.household.present? && meal.user_id != current_user.id %>
            <div class="mt-1 flex items-center space-x-1.5 text-xs text-slate-500 font-medium">
              <span class="w-4 h-4 rounded-full bg-slate-200 flex items-center justify-center text-[9px] font-bold text-slate-700">
                <%= meal.user.display_name.first.upcase %>
              </span>
              <span>Registrado por <strong><%= meal.user.display_name %></strong></span>
            </div>
          <% end %>

          <% if meal.note.present? %>
            <p class="text-xs text-slate-600 mt-1 italic">
              "<%= meal.note %>"
            </p>
          <% end %>
        </div>
      </div>

      <!-- Acciones de edición y borrado -->
      <div class="flex items-center space-x-1">
        <% if meal.user_id == current_user.id || current_user.admin? %>
          <%= button_to meal_log_path(meal), method: :delete, data: { turbo_confirm: "¿Deseas borrar esta comida?" }, class: "p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition cursor-pointer", title: "Eliminar" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          <% end %>
        <% end %>
      </div>
    </div>

    <!-- Barra interactiva de reacciones (Emojis) -->
    <%= render "dashboard/meal_reactions", meal: meal %>

  <% else %>
    <!-- Estado: No registrado (botones Calle y Casa con microformulario animado) -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-11 h-11 rounded-2xl bg-slate-100 flex items-center justify-center text-xl text-slate-600">
          <%= icon %>
        </div>
        <div>
          <h3 class="font-bold text-slate-800 text-base"><%= title %></h3>
          <p class="text-xs text-slate-600 font-medium">¿Dónde comiste hoy?</p>
        </div>
      </div>
    </div>

    <!-- Botones táctiles de selección rápida -->
    <div class="grid grid-cols-2 gap-2.5 mt-3.5">
      <button type="button"
              data-action="click->meal-slot#select"
              data-location="home"
              data-meal-slot-target="homeBtn"
              class="w-full py-2.5 px-3 rounded-2xl bg-emerald-50 hover:bg-emerald-100/90 text-emerald-800 font-semibold text-sm flex items-center justify-center space-x-2 border border-emerald-200/60 shadow-2xs active:scale-[0.98] transition cursor-pointer">
        <span class="text-base">🏠</span>
        <span>En Casa</span>
      </button>

      <button type="button"
              data-action="click->meal-slot#select"
              data-location="street"
              data-meal-slot-target="streetBtn"
              class="w-full py-2.5 px-3 rounded-2xl bg-amber-50 hover:bg-amber-100/90 text-amber-800 font-semibold text-sm flex items-center justify-center space-x-2 border border-amber-200/60 shadow-2xs active:scale-[0.98] transition cursor-pointer">
        <span class="text-base">🍔</span>
        <span>En la Calle</span>
      </button>
    </div>

    <!-- Contenedor desplegable animado para ingresar el monto y cargar -->
    <div data-meal-slot-target="formContainer" class="hidden max-h-0 opacity-0 -translate-y-2 transition-all duration-300 ease-out overflow-hidden mt-3 pt-3 border-t border-slate-100">
      <%= form_with(model: MealLog.new, url: meal_logs_path, class: "space-y-3", data: { turbo: true }) do |f| %>
        <%= f.hidden_field :date, value: date %>
        <%= f.hidden_field :meal_type, value: meal_type %>
        <%= f.hidden_field :location, value: "street", data: { "meal-slot-target": "locationInput" } %>

        <!-- Mensajes contextuales -->
        <div data-meal-slot-target="homeNotice" class="hidden p-2.5 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-medium flex items-center space-x-1.5 border border-emerald-100">
          <span>🏠</span>
          <span>Comida casera (sin gasto en la calle). Presiona Cargar para registrarla.</span>
        </div>

        <div data-meal-slot-target="streetNotice" class="hidden p-2.5 rounded-xl bg-amber-50 text-amber-800 text-xs font-medium flex items-center space-x-1.5 border border-amber-100">
          <span>💸</span>
          <span>Registra lo que pagaste para llevar el control exacto de tus gastos fuera.</span>
        </div>

        <!-- Campo de Monto (solo para Calle con selector Dual USD/Bs) -->
        <div data-meal-slot-target="amountWrapper" class="space-y-1.5">
          <%= f.hidden_field :currency, id: "meal_currency_#{meal_type}", value: "USD" %>
          <%= f.hidden_field :bcv_rate, value: PaymentSetting.current.usd_to_bs_rate %>

          <div class="flex items-center justify-between">
            <label data-meal-slot-target="amountLabel" class="block text-xs font-bold text-slate-700">
              ¿Cuánto gastaste?
            </label>
            <div class="flex items-center space-x-1 text-[11px] font-bold">
              <button type="button" onclick="setSlotCurrency('<%= meal_type %>', 'USD')" id="slot_btn_usd_<%= meal_type %>" class="px-2 py-0.5 rounded-lg bg-emerald-600 text-white border border-emerald-600 shadow-2xs">
                $ USD
              </button>
              <button type="button" onclick="setSlotCurrency('<%= meal_type %>', 'VES')" id="slot_btn_ves_<%= meal_type %>" class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200">
                Bs.
              </button>
            </div>
          </div>

          <div class="relative rounded-2xl shadow-2xs" data-controller="money-mask">
            <div id="slot_symbol_<%= meal_type %>" class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 font-bold text-base">
              $
            </div>
            <%= f.hidden_field :original_amount,
                               id: "slot_amount_#{meal_type}",
                               oninput: "calculateSlotLiveConversion('#{meal_type}', this.value)",
                               data: { "money-mask-target": "hidden" } %>
            <input type="text"
                   inputmode="numeric"
                   autocomplete="off"
                   id="slot_display_<%= meal_type %>"
                   placeholder="0,00"
                   data-money-mask-target="display"
                   data-meal-slot-target="amountInput"
                   class="block w-full pl-8 pr-10 py-2.5 text-base font-bold text-slate-900 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition">
            <button type="button"
                    tabindex="-1"
                    data-action="click->money-mask#clear"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-slate-300 hover:text-slate-500 text-xs font-bold transition cursor-pointer"
                    title="Borrar monto">
              ✕
            </button>
          </div>

          <p id="slot_conversion_<%= meal_type %>" class="text-[11px] text-blue-700 font-medium">
            Tasa BCV: <strong><%= sprintf('%.2f', PaymentSetting.current.usd_to_bs_rate) %> Bs / USD</strong>
          </p>
        </div>

        <!-- Campo de Lugar (solo para Calle) -->
        <div data-meal-slot-target="placeWrapper">
          <label class="block text-xs font-bold text-slate-700 mb-1">
            Lugar o Restaurante <span class="text-slate-400 font-normal">(opcional)</span>
          </label>
          <%= f.text_field :place_name,
                           placeholder: "Ej. Taquería, McDonald's, Pizzería...",
                           data: { "meal-slot-target": "placeInput" },
                           class: "block w-full px-3.5 py-2 text-xs font-medium text-slate-900 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition" %>
        </div>

        <!-- Nota opcional -->
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">
            Nota <span class="text-slate-400 font-normal">(opcional)</span>
          </label>
          <%= f.text_field :note,
                           placeholder: "Ej. 2 tacos y jugo, ensalada con pollo...",
                           class: "block w-full px-3.5 py-2 text-xs font-medium text-slate-900 bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition" %>
        </div>

        <!-- Botón de Envío y Cancelar -->
        <div class="flex items-center space-x-2 pt-1">
          <button type="submit"
                  class="flex-1 py-3 px-4 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-700 hover:to-teal-600 text-white font-bold text-sm shadow-md shadow-emerald-500/20 active:scale-[0.98] transition cursor-pointer flex items-center justify-center space-x-1.5">
            <span>✓ Cargar Comida</span>
          </button>

          <button type="button"
                  data-action="click->meal-slot#cancel"
                  class="py-3 px-4 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-600 font-semibold text-xs active:scale-[0.98] transition cursor-pointer">
            Cancelar
          </button>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<script>
  if (typeof window.slotCurrencies === 'undefined') {
    window.slotCurrencies = {};
  }

  function setSlotCurrency(type, curr) {
    window.slotCurrencies[type] = curr;
    const inputCurr = document.getElementById('meal_currency_' + type);
    if (inputCurr) inputCurr.value = curr;

    const btnUsd = document.getElementById('slot_btn_usd_' + type);
    const btnVes = document.getElementById('slot_btn_ves_' + type);
    const symbol = document.getElementById('slot_symbol_' + type);

    if (curr === 'VES') {
      btnVes.className = "px-2 py-0.5 rounded-lg bg-blue-600 text-white border border-blue-600 shadow-2xs font-bold";
      btnUsd.className = "px-2 py-0.5 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 font-bold";
      if (symbol) symbol.innerText = "Bs.";
    } else {
      btnUsd.className = "px-2 py-0.5 rounded-lg bg-emerald-600 text-white border border-emerald-600 shadow-2xs font-bold";
      btnVes.className = "px-2 py-0.5 rounded-lg bg-slate-100 text-slate-600 border border-slate-200 hover:bg-slate-200 font-bold";
      if (symbol) symbol.innerText = "$";
    }

    const val = document.getElementById('slot_amount_' + type)?.value;
    calculateSlotLiveConversion(type, val);
  }

  function calculateSlotLiveConversion(type, val) {
    const num = parseFloat(val) || 0;
    const preview = document.getElementById('slot_conversion_' + type);
    if (!preview) return;

    const rate = <%= PaymentSetting.current.usd_to_bs_rate %>;
    const curr = window.slotCurrencies[type] || 'USD';

    if (num <= 0) {
      preview.innerHTML = `Tasa BCV: <strong>${rate.toFixed(2)} Bs / USD</strong>`;
      return;
    }

    if (curr === 'VES') {
      const usdEquiv = (num / rate).toFixed(2);
      preview.innerHTML = `≈ <strong class="text-emerald-700">$${usdEquiv} USD</strong> (tasa BCV: ${rate.toFixed(2)} Bs/$)`;
    } else {
      const bsEquiv = (num * rate).toFixed(2);
      preview.innerHTML = `≈ <strong class="text-blue-800">${bsEquiv} Bs.</strong> (tasa BCV: ${rate.toFixed(2)} Bs/$)`;
    }
  }
</script>
