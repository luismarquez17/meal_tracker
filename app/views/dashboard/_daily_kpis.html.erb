<%
  currency = current_setting.currency_symbol
  rate = PaymentSetting.current.usd_to_bs_rate
  bs_amount = (@day_street_spent.to_f * rate).round(2)
%>
<div id="daily_kpis" class="grid grid-cols-2 gap-3">
  <!-- Gasto Total Hoy (Comidas + Gastos Hormiga) -->
  <div class="bg-white rounded-3xl p-3.5 border border-slate-100/90 shadow-2xs">
    <div class="flex items-center justify-between text-xs font-semibold text-slate-600 mb-1">
      <div class="flex items-center space-x-1.5">
        <span>💸</span>
        <span>Gasto de Hoy</span>
      </div>
      <% if @day_micro_spent.to_f > 0 %>
        <span class="text-[10px] bg-amber-100 text-amber-800 px-1.5 py-0.2 rounded-full font-bold">+Hormiga</span>
      <% end %>
    </div>
    <div class="text-xl font-black <%= @day_street_spent.positive? ? 'text-rose-600' : 'text-slate-800' %>">
      <%= currency %><%= number_with_precision(@day_street_spent, precision: 2) %>
    </div>
    <div class="text-[11px] text-slate-500 font-mono mt-0.5">
      ≈ <%= number_with_delimiter(sprintf('%.2f', bs_amount)) %> Bs.
    </div>
  </div>

  <!-- Comidas en Casa Hoy -->
  <div class="bg-white rounded-3xl p-3.5 border border-slate-100/90 shadow-2xs">
    <div class="flex items-center space-x-1.5 text-xs font-semibold text-emerald-700 mb-1">
      <span>🏠</span>
      <span>En Casa</span>
    </div>
    <div class="text-xl font-black text-emerald-600">
      <%= @meals.select(&:home?).size %>
    </div>
    <div class="text-[11px] text-slate-500 mt-0.5">
      <%= @meals.select(&:home?).size == 1 ? "comida casera" : "comidas caseras" %> hoy
    </div>
  </div>
</div>
