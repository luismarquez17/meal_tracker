<%
  currency = current_setting.currency_symbol
  month_name = spanish_month_name(@date)
%>
<div id="monthly_kpis" class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-3xl p-5 shadow-lg relative overflow-hidden">
  <!-- Fondo decorativo sutil -->
  <div class="absolute -right-6 -bottom-6 w-36 h-36 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>

  <div class="flex items-center justify-between mb-4">
    <div>
      <span class="text-xs font-semibold text-amber-400 uppercase tracking-wider">Gastos en la Calle</span>
      <h2 class="text-base font-bold text-slate-100 capitalize"><%= month_name %></h2>
    </div>
    <%= link_to analytics_path(date: @date), class: "text-xs font-semibold text-amber-400 hover:text-amber-300 bg-amber-950/60 border border-amber-500/30 px-3 py-1.5 rounded-full transition flex items-center space-x-1" do %>
      <span>Ver estadísticas</span>
      <span>→</span>
    <% end %>
  </div>

  <div class="grid grid-cols-2 gap-4 pb-4 border-b border-slate-700/60">
    <div>
      <div class="text-xs text-slate-400 font-medium">Total Gastado</div>
      <div class="text-2xl font-black text-amber-400 mt-0.5">
        <%= currency %><%= number_with_precision(@month_street_spent, precision: 2) %>
      </div>
      <div class="text-[11px] text-slate-400 mt-0.5">
        <%= @month_street_count %> <%= @month_street_count == 1 ? "salida registrada" : "salidas registradas" %>
      </div>
    </div>

    <div>
      <div class="text-xs text-slate-400 font-medium">Promedio por Salida</div>
      <div class="text-2xl font-black text-slate-100 mt-0.5">
        <%= currency %><%= number_with_precision(@avg_street_cost, precision: 2) %>
      </div>
      <div class="text-[11px] text-slate-400 mt-0.5">
        por comida fuera
      </div>
    </div>
  </div>

  <!-- Frecuencia de hábitos de comida -->
  <div class="mt-3 flex items-center justify-between text-xs text-slate-300 font-medium">
    <span>Comidas en casa vs calle:</span>
    <span class="font-bold text-emerald-400">
      <%= @month_home_count %> casa · <%= @month_street_count %> calle (<%= @home_ratio %>%)
    </span>
  </div>
</div>
