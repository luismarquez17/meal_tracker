<div id="payment_row_<%= payment.id %>" class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:border-emerald-300 transition-all overflow-hidden">
  <div class="p-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
      <!-- Info del Pago y Usuario -->
      <div class="flex items-start space-x-3">
        <div class="w-11 h-11 rounded-2xl bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center text-xl shrink-0">
          <%= payment.method_icon %>
        </div>
        <div>
          <div class="flex items-center space-x-2 flex-wrap">
            <span class="font-extrabold text-slate-900 text-sm"><%= payment.human_method %></span>
            <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
              Pendiente
            </span>
            <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">
              $<%= sprintf('%.2f', payment.amount) %> USD
            </span>
            <% if payment.payment_method == "pago_movil" %>
              <% rate = PaymentSetting.current.usd_to_bs_rate %>
              <span class="text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-full">
                ~ <%= sprintf('%.2f', (payment.amount * rate).round(2)) %> Bs. (tasa: <%= sprintf('%.2f', rate) %>)
              </span>
            <% end %>
          </div>
          <p class="text-xs text-slate-600 mt-1 font-medium">
            Cliente: <span class="font-bold text-slate-900"><%= payment.user.name %></span> (<%= payment.user.email %>)
          </p>
          <p class="text-xs text-slate-500 font-mono mt-0.5">
            Ref: <span class="bg-slate-100 text-slate-800 px-1.5 py-0.5 rounded font-bold"><%= payment.reference_number %></span>
            <span class="text-slate-400 text-[11px] ml-2">Hace <%= time_ago_in_words(payment.created_at) %></span>
          </p>
          <% if payment.notes.present? %>
            <p class="text-xs text-slate-500 italic mt-1 bg-slate-50 p-2 rounded-xl border border-slate-100">
              "<%= payment.notes %>"
            </p>
          <% end %>
        </div>
      </div>

      <!-- Botones de Acción de 1 Clic -->
      <div class="flex items-center space-x-2 self-end sm:self-center shrink-0">
        <%= button_to approve_admin_payment_path(payment), method: :post, class: "px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-md shadow-emerald-500/20 active:scale-95 transition flex items-center space-x-1.5 cursor-pointer" do %>
          <span>✅</span>
          <span>Aprobar (+30 días)</span>
        <% end %>

        <%= button_to reject_admin_payment_path(payment), method: :post, data: { turbo_confirm: "¿Estás seguro de rechazar este pago?" }, class: "px-3 py-2 rounded-xl bg-slate-100 hover:bg-rose-50 text-slate-600 hover:text-rose-600 font-bold text-xs transition active:scale-95 cursor-pointer" do %>
          <span>❌</span>
          <span>Rechazar</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Foto del comprobante directamente visible pequeñita debajo de la carta -->
  <% if payment.receipt.attached? %>
    <div class="px-4 py-3 bg-slate-50/90 border-t border-slate-100 flex items-center justify-between gap-3">
      <div class="flex items-center space-x-3">
        <!-- Imagencita pequeña visible directamente con efecto hover -->
        <% if payment.receipt.content_type.to_s.start_with?("image/") %>
          <div class="relative group cursor-pointer shrink-0" onclick="document.getElementById('receipt_modal_<%= payment.id %>').classList.remove('hidden')">
            <img src="<%= url_for(payment.receipt) %>" alt="Comprobante pequeño" class="w-14 h-14 object-cover rounded-xl border border-slate-300 group-hover:border-emerald-500 group-hover:scale-105 shadow-xs transition-all" />
            <div class="absolute inset-0 bg-black/30 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold">
              🔍
            </div>
          </div>
        <% else %>
          <div class="w-14 h-14 rounded-xl bg-slate-200 border border-slate-300 flex items-center justify-center text-2xl cursor-pointer shrink-0" onclick="document.getElementById('receipt_modal_<%= payment.id %>').classList.remove('hidden')">
            📄
          </div>
        <% end %>

        <div>
          <p class="text-xs font-extrabold text-slate-800 flex items-center space-x-1.5">
            <span>Comprobante Adjunto</span>
            <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.2 rounded-full">Listo para verificar</span>
          </p>
          <p class="text-[11px] text-slate-500 mt-0.5">
            Toca la foto para verla en tamaño grande
          </p>
        </div>
      </div>

      <!-- Botón para ampliar -->
      <button type="button" onclick="document.getElementById('receipt_modal_<%= payment.id %>').classList.remove('hidden')" class="inline-flex items-center space-x-1.5 text-xs font-bold text-emerald-700 bg-white hover:bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-200 shadow-2xs transition active:scale-95 cursor-pointer shrink-0">
        <span>🔍</span>
        <span>Ampliar foto</span>
      </button>
    </div>

    <!-- Modal para ver la imagen en grande -->
    <div id="receipt_modal_<%= payment.id %>" class="hidden fixed inset-0 z-50 overflow-y-auto bg-slate-950/85 backdrop-blur-xs flex items-center justify-center p-4" onclick="if(event.target === this) this.classList.add('hidden')">
      <div class="relative bg-white rounded-3xl max-w-xl w-full p-5 shadow-2xl border border-slate-200 animate-scale-in">
        <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
          <div>
            <h3 class="text-sm font-extrabold text-slate-900 flex items-center space-x-1.5">
              <span>📷</span>
              <span>Comprobante de <%= payment.user.name %></span>
            </h3>
            <p class="text-xs text-slate-500 font-mono mt-0.5">
              Ref: <strong class="text-slate-800"><%= payment.reference_number %></strong> • Monto: <strong class="text-emerald-600">$<%= sprintf('%.2f', payment.amount) %> USD</strong>
              <% if payment.payment_method == "pago_movil" %>
                • <strong class="text-blue-600">~<%= sprintf('%.2f', (payment.amount * PaymentSetting.current.usd_to_bs_rate).round(2)) %> Bs.</strong>
              <% end %>
            </p>
          </div>
          <button type="button" onclick="document.getElementById('receipt_modal_<%= payment.id %>').classList.add('hidden')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center font-bold text-sm transition cursor-pointer">
            ✕
          </button>
        </div>

        <!-- Foto en Grande -->
        <div class="my-3 flex items-center justify-center bg-slate-950/5 rounded-2xl p-2 max-h-[72vh] overflow-hidden">
          <% if payment.receipt.content_type.to_s.start_with?("image/") %>
            <img src="<%= url_for(payment.receipt) %>" alt="Comprobante en grande" class="max-h-[68vh] max-w-full object-contain rounded-xl shadow-md" />
          <% else %>
            <iframe src="<%= url_for(payment.receipt) %>" class="w-full h-80 rounded-xl"></iframe>
          <% end %>
        </div>

        <div class="flex items-center justify-between pt-2">
          <%= link_to rails_blob_path(payment.receipt, disposition: "inline"), target: "_blank", data: { turbo: false }, class: "text-xs font-bold text-blue-600 hover:text-blue-800 flex items-center space-x-1 hover:underline" do %>
            <span>Abrir en pestaña nueva ↗</span>
          <% end %>

          <button type="button" onclick="document.getElementById('receipt_modal_<%= payment.id %>').classList.add('hidden')" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs transition cursor-pointer">
            Cerrar (✕)
          </button>
        </div>
      </div>
    </div>
  <% end %>
</div>
