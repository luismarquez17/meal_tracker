<div class="max-w-md mx-auto space-y-5 animate-fade-in">
  <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-4">
    <div class="flex items-center space-x-3 mb-2">
      <div class="w-10 h-10 rounded-2xl bg-amber-50 text-amber-700 flex items-center justify-center text-lg font-bold">
        🔑
      </div>
      <div>
        <h2 class="text-base font-black text-slate-900">Cambiar Contraseña</h2>
        <p class="text-xs text-slate-500 font-medium">Protege tu cuenta con una clave segura</p>
      </div>
    </div>

    <%= form_with url: update_password_profile_path, method: :patch, local: true, class: "space-y-4 text-xs" do |f| %>
      <div class="space-y-1">
        <%= label_tag "user[current_password]", "Contraseña Actual", class: "block font-bold text-slate-700" %>
        <%= password_field_tag "user[current_password]", nil, required: true, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
      </div>

      <div class="space-y-1">
        <%= label_tag "user[new_password]", "Nueva Contraseña (mínimo 6 caracteres)", class: "block font-bold text-slate-700" %>
        <%= password_field_tag "user[new_password]", nil, required: true, minlength: 6, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
      </div>

      <div class="space-y-1">
        <%= label_tag "user[new_password_confirmation]", "Confirmar Nueva Contraseña", class: "block font-bold text-slate-700" %>
        <%= password_field_tag "user[new_password_confirmation]", nil, required: true, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
      </div>

      <div class="pt-2 flex gap-2">
        <%= f.submit "Actualizar Contraseña", class: "flex-1 py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs transition active:scale-95 cursor-pointer" %>
        <%= link_to "Cancelar", profile_path, class: "py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition active:scale-95" %>
      </div>
    <% end %>
  </div>
</div>
