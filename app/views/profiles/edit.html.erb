<div class="max-w-md mx-auto space-y-5 animate-fade-in">
  <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm space-y-4">
    <div class="flex items-center space-x-3 mb-2">
      <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center text-lg font-bold">
        ✏️
      </div>
      <div>
        <h2 class="text-base font-black text-slate-900">Editar Perfil</h2>
        <p class="text-xs text-slate-500 font-medium">Actualiza tu foto e información personal</p>
      </div>
    </div>

    <%= form_with model: @user, url: profile_path, method: :patch, local: true, class: "space-y-4 text-xs" do |f| %>
      <% if @user.errors.any? %>
        <div class="p-3 bg-rose-50 border border-rose-200 text-rose-800 rounded-2xl">
          <ul class="list-disc pl-4 space-y-1">
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Previsualización de la foto actual -->
      <div class="flex items-center space-x-4 p-3 bg-slate-50 rounded-2xl border border-slate-100">
        <div class="w-16 h-16 rounded-full border-2 border-emerald-500 overflow-hidden bg-white shrink-0 shadow-xs">
          <%= image_tag(@user.profile_avatar_image, class: "w-full h-full object-cover", id: "avatar-preview") %>
        </div>
        <div class="space-y-1">
          <span class="block font-bold text-slate-800">Foto actual</span>
          <p class="text-[11px] text-slate-500">Se mantendrá guardada para siempre a menos que la cambies o elimines.</p>
          <% if @user.avatar.attached? || @user.avatar_url.present? %>
            <label class="inline-flex items-center space-x-1.5 text-rose-600 hover:text-rose-700 font-bold text-[11px] cursor-pointer pt-1">
              <%= check_box_tag "user[remove_avatar]", "1", false, class: "rounded border-slate-300 text-rose-600 focus:ring-rose-500" %>
              <span>Quitar foto de perfil</span>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Subir archivo de imagen desde teléfono o PC -->
      <div class="space-y-1.5">
        <%= f.label :avatar, "Subir foto desde tu dispositivo (Teléfono o PC)", class: "block font-bold text-slate-700" %>
        <div class="flex items-center justify-center w-full">
          <label class="flex flex-col items-center justify-center w-full h-28 border-2 border-dashed border-emerald-300 rounded-2xl cursor-pointer bg-emerald-50/40 hover:bg-emerald-50/70 transition">
            <div class="flex flex-col items-center justify-center pt-2 pb-3">
              <span class="text-2xl mb-1">📸</span>
              <p class="text-xs font-bold text-slate-700">Toca para elegir foto o tomar captura</p>
              <p class="text-[10px] text-slate-500 mt-0.5">PNG, JPG, JPEG, WEBP o HEIC</p>
            </div>
            <%= f.file_field :avatar, accept: "image/*", class: "hidden", onchange: "if (this.files && this.files[0]) { const reader = new FileReader(); reader.onload = function(e) { document.getElementById('avatar-preview').src = e.target.result; }; reader.readAsDataURL(this.files[0]); }" %>
          </label>
        </div>
      </div>

      <div class="space-y-1">
        <%= f.label :name, "Nombre Completo", class: "block font-bold text-slate-700" %>
        <%= f.text_field :name, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
      </div>

      <div class="space-y-1">
        <%= f.label :email, "Correo Electrónico", class: "block font-bold text-slate-700" %>
        <%= f.email_field :email, class: "w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
      </div>

      <!-- Opción alternativa: URL externa si prefiere -->
      <div class="space-y-1 pt-1 border-t border-slate-100">
        <%= f.label :avatar_url, "O usar enlace de imagen en la web (URL opcional)", class: "block font-medium text-slate-500" %>
        <%= f.url_field :avatar_url, placeholder: "https://ejemplo.com/mifoto.jpg", class: "w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-emerald-500 focus:outline-none" %>
      </div>

      <div class="pt-3 flex gap-2">
        <%= f.submit "Guardar Cambios", class: "flex-1 py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs transition active:scale-95 cursor-pointer" %>
        <%= link_to "Cancelar", profile_path, class: "py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition active:scale-95" %>
      </div>
    <% end %>
  </div>
</div>
