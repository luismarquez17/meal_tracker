<div class="max-w-md mx-auto space-y-5 animate-fade-in">
  <!-- Tarjeta de Perfil -->
  <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm text-center relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-20 bg-gradient-to-r from-emerald-600 to-teal-500"></div>
    
    <div class="relative pt-6 flex flex-col items-center">
      <div class="w-24 h-24 rounded-full border-4 border-white shadow-md overflow-hidden bg-slate-100 mb-3">
        <%= image_tag(@user.profile_avatar_image, class: "w-full h-full object-cover") %>
      </div>
      
      <h2 class="text-lg font-black text-slate-900"><%= @user.name.presence || "Usuario MealTracker" %></h2>
      <p class="text-xs font-semibold text-slate-500"><%= @user.email %></p>

      <div class="mt-3 flex items-center gap-2">
        <% if @user.admin? %>
          <span class="px-2.5 py-0.5 bg-amber-100 text-amber-800 rounded-full text-xs font-black">👑 Super Administrador</span>
        <% end %>
        <% if @user.active_subscription? %>
          <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 rounded-full text-xs font-bold">⭐ Suscripción Activa</span>
        <% else %>
          <span class="px-2.5 py-0.5 bg-rose-100 text-rose-800 rounded-full text-xs font-bold">⚠️ Suscripción Vencida</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Detalles & Ajustes de Cuenta -->
  <div class="bg-white rounded-3xl p-5 border border-slate-100 shadow-sm space-y-4">
    <h3 class="text-xs font-black uppercase tracking-wider text-slate-400">Información de la Cuenta</h3>

    <div class="divide-y divide-slate-100 text-xs">
      <div class="py-2.5 flex items-center justify-between">
        <span class="text-slate-500 font-medium">Nombre</span>
        <span class="text-slate-900 font-bold"><%= @user.name.presence || "Sin definir" %></span>
      </div>
      <div class="py-2.5 flex items-center justify-between">
        <span class="text-slate-500 font-medium">Correo Electrónico</span>
        <span class="text-slate-900 font-bold"><%= @user.email %></span>
      </div>
      <div class="py-2.5 flex items-center justify-between">
        <span class="text-slate-500 font-medium">Método de Acceso</span>
        <span class="text-slate-900 font-bold">
          <% if @user.google_uid.present? %>
            Google Account
          <% else %>
            Correo y Contraseña
          <% end %>
        </span>
      </div>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row gap-2">
      <%= link_to edit_profile_path, class: "flex-1 py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-xs text-center transition active:scale-95 flex items-center justify-center space-x-1" do %>
        <span>✏️</span>
        <span>Editar Perfil</span>
      <% end %>

      <%= link_to change_password_profile_path, class: "flex-1 py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl text-center transition active:scale-95 flex items-center justify-center space-x-1" do %>
        <span>🔑</span>
        <span>Cambiar Contraseña</span>
      <% end %>
    </div>
  </div>

  <div class="text-center">
    <%= link_to root_path, class: "text-xs font-semibold text-slate-500 hover:text-slate-800 transition" do %>
      ← Volver al Inicio
    <% end %>
  </div>
</div>
